# ShopNest Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI (or local fallback: mongodb://127.0.0.1:27017/shopnest)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopnest?retryWrites=true&w=majority

# JSON Web Token Secret
JWT_SECRET=shopnest_jwt_super_secret_production_key_2026

# Razorpay Test Mode Credentials (Optional for production; simulated in dev mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Cloudinary Storage Credentials (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
